# Optional. Copy to .env only if you need one of the settings below; the proxy runs
# without it.
#
# Only the two settings below reach the container. docker-compose.yml passes them
# through by name and no longer loads this file wholesale, so anything else in it --
# including AWS_* lines left over from the old sample -- is ignored. AWS credentials
# are read from ~/.env.aws while the proxy is running, via the credential_process
# shim in scripts/. Delete any AWS credentials still in here; they are no longer used.

# Seconds between scheduled re-reads of ~/.env.aws. Default 900 (15 minutes), max 900.
# The observed interval is shorter -- see README.
# LITELLM_CREDS_REREAD_DELAY=900

# Minimum seconds between re-reads triggered by AWS rejecting the credentials.
# Default 60. Lowering it towards 0 approaches one re-read per failed request.
# LITELLM_CREDS_ERROR_REREAD_COOLDOWN=60
