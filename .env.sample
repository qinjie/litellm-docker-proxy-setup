# LiteLLM Proxy Environment Variables
# Copy this file to .env and fill in values as needed.
# Empty values will fall back to shell environment variables.

# AWS Credentials (leave empty to use shell env vars)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Region (set default here)
AWS_DEFAULT_REGION=us-west-2
